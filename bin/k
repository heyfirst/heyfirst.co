#!/bin/sh
# Kamal with .env loaded. Stops first when .env lacks a key from .env.example.
set -e
cd "$(dirname "$0")/.."

bun scripts/check-env.ts

set -a
. ./.env
set +a

# kamal does not evaluate command substitution inside .kamal/secrets values, so the field name is split here.
OP_REGISTRY_FIELD="$(basename "$OP_REGISTRY_ITEM")"
export OP_REGISTRY_FIELD

GIT_SHA="$(git rev-parse --short HEAD)"
export GIT_SHA

exec kamal "$@"
