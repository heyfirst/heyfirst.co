# Names only: this file is public. Real values live in .env (never committed).
#
# First run on a laptop (throwaway local values):
#   1. docker compose up -d --wait     Postgres 17 on PG_PORT (default 5432); change PG_PORT and the port in DATABASE_URL if 5432 is taken
#   2. cp .env.example .env            the local keys below already have working values
#   3. bun install
#   4. bun start                       builds, then serves SITE_URL; EmDash runs its migrations and applies seed/seed.json on the first request
#   5. open SITE_URL/_emdash/admin     create the admin account (passkey) in the setup wizard
#   6. optional: bun run seed:sample   adds a sample post, snippet and project so the index is not empty
# `bun run dev` is the hot-reload server and reads the same .env.
#
# A key whose line ends in "# optional" may stay empty. `bun run env:check` fails on every other
# key that .env lacks or leaves empty, and bin/k runs it before every kamal command.

# ---- local: bun start, bun run dev, bun test ----
DATABASE_URL=postgres://ci:ci@127.0.0.1:5432/ci
# The public origin the local app serves on (EmDash refuses setup without it).
SITE_URL=http://localhost:4321
# Extra origin that may sign in with passkeys. Empty locally.
STAGING_ORIGIN= # optional
UPLOADS_DIR=./uploads
HOST=127.0.0.1
PORT=4321
HEYFIRST_DENYLIST= # optional
PG_PORT=5432 # optional

# ---- deploy: see docs/deploy.md ----
# The image bakes these in at build time. The origin is the FINAL domain; the staging origin is the
# host passkeys may also sign in on and must be https://<PROXY_HOST>.
DEPLOY_SITE_URL=
DEPLOY_STAGING_ORIGIN=
# The host name kamal-proxy answers to. First deploy: a throwaway name. Then the staging name.
PROXY_HOST=
# Names the environment on traces and logs: staging or production.
DEPLOYMENT_ENVIRONMENT=
# The server that runs the container, and the ghcr.io account that owns the image.
DEPLOY_HOST=
REGISTRY_USER=
# 1Password lookup for the registry token (.kamal/secrets): account, vault, and "item/field".
OP_ACCOUNT=
OP_VAULT=
OP_REGISTRY_ITEM=
# The shared Postgres, read by the container at runtime (never at build). The DEPLOY_ prefix keeps these out of local runs: Bun loads .env into every local command, and a bare PGHOST would point tests at this server. The link is the private
# encrypted tailnet, so config/deploy.yml sets PGSSLMODE=disable itself.
DEPLOY_PGHOST=
DEPLOY_PGPORT=5432
DEPLOY_PGUSER=
DEPLOY_PGPASSWORD=
DEPLOY_PGDATABASE=
# Telemetry.
OTLP_ENDPOINT=
HYPERDX_API_KEY=
# For `bun run import` and `bun run verify:content`. The token exists only after the first deploy
# (docs/deploy.md), so it is empty until then.
EMDASH_URL= # optional
EMDASH_TOKEN= # optional
