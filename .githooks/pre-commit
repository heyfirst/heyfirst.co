#!/usr/bin/env bash
set -euo pipefail

gitleaks git --staged --redact --config .gitleaks.toml --no-banner

denylist="${HEYFIRST_DENYLIST:-}"
if [ -z "$denylist" ]; then
  echo "pre-commit: HEYFIRST_DENYLIST is unset; denylist check skipped (the pre-push hook is the backstop)" >&2
  exit 0
fi
if [ ! -f "$denylist" ] || [ ! -r "$denylist" ]; then
  echo "pre-commit: HEYFIRST_DENYLIST is set but is not a readable file" >&2
  exit 1
fi

added=$(git diff --cached --no-color --unified=0 | grep -E '^\+' | grep -vE '^\+\+\+ ' || true)
if [ -n "$added" ] && printf '%s\n' "$added" | grep -qiEf <(grep -v '^[[:space:]]*$' "$denylist"); then
  echo "pre-commit: staged change matches the private denylist" >&2
  exit 1
fi
