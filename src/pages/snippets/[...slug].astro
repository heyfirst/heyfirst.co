---
import SnippetsIndex from "@/components/snippet/SnippetsIndex.astro";
import Snippet from "@/components/snippet/Snippet.astro";
import { getAllSnippets, getSnippet } from "@/data/snippet";
import PageLayout from "@/layouts/Base.astro";
import { paginate, parsePageNumber } from "@/utils/paginate";

const { slug } = Astro.params;
const isIndex = !slug || /^\d+$/.test(slug);
const page = isIndex ? paginate(await getAllSnippets(), parsePageNumber(slug), "/snippets/") : null;
const snippet = isIndex || !slug ? null : await getSnippet(slug);

if (!page && !snippet) return Astro.rewrite("/404");

const meta = snippet
	? {
			description:
				snippet.data.description ||
				`Read about my snippet posted on: ${snippet.data.publishDate.toLocaleDateString()}`,
			title: snippet.data.title,
		}
	: { description: "Read my collection of snippets", title: "Snippets" };
---

<PageLayout meta={meta}>
	{page ? <SnippetsIndex page={page} /> : snippet && <Snippet as="h1" snippet={snippet} />}
</PageLayout>
