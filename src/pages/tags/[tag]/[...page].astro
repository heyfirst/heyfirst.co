---
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getPostsPage } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { parsePageNumber } from "@/utils/paginate";

const { tag: tagParam, page: pageParam } = Astro.params;
const result = tagParam ? await getPostsPage(parsePageNumber(pageParam), tagParam) : null;
if (!result?.tag || !result.page.data.length) return Astro.rewrite("/404");
const { page, tag } = result;
if (tagParam !== tag.slug) {
	return Astro.redirect(`/tags/${tag.slug}/${pageParam ?? ""}`, 301);
}

const meta = {
	description: `View all posts with the tag - ${tag.label}`,
	title: `Tag: ${tag.label}`,
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Previous Tags",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Next Tags →",
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<div class="mb-6 flex items-center">
		<h1 class="sr-only">Posts with the tag {tag.label}</h1>
		<a class="title text-accent" href="/tags/"><span class="sr-only">All {" "}</span>Tags</a>
		<span aria-hidden="true" class="ms-2 me-3 text-xl">→</span>
		<span aria-hidden="true" class="text-xl">#{tag.label}</span>
	</div>
	<section aria-labelledby={`tags-${tag.slug}`}>
		<h2 id={`tags-${tag.slug}`} class="sr-only">Post List</h2>
		<ul class="space-y-4">
			{
				page.data.map((p) => (
					<li class="grid gap-2 sm:grid-cols-[auto_1fr]">
						<PostPreview as="h2" post={p} />
					</li>
				))
			}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
