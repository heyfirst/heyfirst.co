---
import PostsIndex from "@/components/blog/PostsIndex.astro";
import Body from "@/components/portable-text/Body.astro";
import PageLayout from "@/layouts/Base.astro";
import PostLayout from "@/layouts/BlogPost.astro";
import { getPost, getPostsPage } from "@/data/post";
import { isPageParam, parsePageNumber } from "@/utils/paginate";

const { slug } = Astro.params;
const isIndex = isPageParam(slug);
const index = isIndex ? await getPostsPage(parsePageNumber(slug)) : null;
const post = isIndex || !slug ? null : await getPost(slug);

if (!index && !post) return Astro.rewrite("/404");

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: "Posts",
};
---

{
	index ? (
		<PageLayout meta={meta}>
			<PostsIndex {...index} />
		</PageLayout>
	) : (
		post && (
			<PostLayout post={post}>
				<Body value={post.body} />
			</PostLayout>
		)
	)
}
