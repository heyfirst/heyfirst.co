---
import type { PostTag } from "@/data/post";

interface Props {
	tag: PostTag;
}

const { tag } = Astro.props;
---

<a
	class="border-accent text-accent rounded-full border px-2.5 py-0.5 text-sm hover:underline"
	href={`/tags/${tag.slug}/`}
>
	<span class="sr-only">View posts with the tag&nbsp;</span>#{tag.label}
</a>
