---
import FormattedDate from "@/components/FormattedDate.astro";
import TagIcon from "@/components/TagIcon.astro";
import TagPill from "@/components/TagPill.astro";
import type { Post } from "@/data/post";
import { Image } from "emdash/ui";

interface Props {
	content: Post;
	readingTime: string;
}

const {
	content: { data, edit },
	readingTime,
} = Astro.props;

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long",
};
---

{
	data.coverImage && (
		<div class="mb-6 aspect-video">
			<Image class="rounded-md object-cover" image={data.coverImage} width={1280} priority />
		</div>
	)
}
<h1 class="title" {...edit?.title}>
	{data.title}
</h1>
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
	<p class="font-semibold">
		<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} /> /{" "}
		{readingTime}
	</p>
	{
		data.updatedDate && (
			<span class="bg-quote/5 text-quote rounded-lg px-2 py-1">
				Updated:
				<FormattedDate class="ms-1" date={data.updatedDate} dateTimeOptions={dateTimeOptions} />
			</span>
		)
	}
</div>
{
	!!data.tags?.length && (
		<div class="mt-2 flex flex-wrap items-center gap-2">
			<TagIcon class="inline-block h-6 w-6" />
			{data.tags.map((tag) => <TagPill tag={tag} />)}
		</div>
	)
}
