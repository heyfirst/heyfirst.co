---
interface Props {
	href?: string;
	class?: string;
}

const { href, class: className } = Astro.props;

const classes = ["btn", "btn-primary", "btn-md", className]
	.filter(Boolean)
	.join(" ");
---

{
	href ? (
		<a class={classes} href={href}>
			<slot />
		</a>
	) : (
		<button class={classes} type="button">
			<slot />
		</button>
	)
}
