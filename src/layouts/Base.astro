---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import { createPublicPageContext } from "emdash/page";
import { EmDashHead } from "emdash/ui";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { articleDate, content, description = siteConfig.description, ogImage, title },
} = Astro.props;

const siteTitle = `${title} • ${siteConfig.title}`;

const page = createPublicPageContext({
	url: Astro.url,
	kind: content ? "content" : "custom",
	pageType: articleDate ? "article" : "website",
	title: siteTitle,
	pageTitle: title,
	description,
	canonical: new URL(Astro.url.pathname, Astro.site).href,
	image: new URL(ogImage ?? "/social-card.png", Astro.url).href,
	siteName: siteConfig.title,
	...(content && { content }),
	...(articleDate && { articleMeta: { publishedTime: articleDate, author: siteConfig.author } }),
});
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead siteTitle={siteTitle} title={title} />
		<EmDashHead page={page} />
	</head>
	<body
		class="bg-global-bg text-global-text mx-auto flex min-h-screen max-w-3xl flex-col px-4 pt-16 font-body text-base font-normal antialiased sm:px-8"
	>
		<ThemeProvider />
		<SkipLink />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
