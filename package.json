{
	"name": "heyfirst-astro",
	"version": "6.1.1",
	"scripts": {
		"astro:dev": "astro dev",
		"dev": "portless",
		"migrate": "bun scripts/migrate.ts",
		"start": "bun --bun run build && bun scripts/migrate.ts && bun dist/server/entry.mjs",
		"seed:sample": "bun scripts/seed-sample.ts",
		"import": "bun scripts/import-content.ts",
		"verify:content": "bun scripts/verify-content.ts",
		"env:check": "bun scripts/check-env.ts",
		"deploy:check": "bin/k config > /dev/null",
		"stop": "astro dev stop",
		"build": "astro build",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "bun run format:code && bun run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"verify": "bun scripts/verify.ts",
		"verify:fast": "bun scripts/verify.ts --fast",
		"check:admin": "bun scripts/check-admin.ts",
		"test": "bun test",
		"test:db": "bun --config=tests/bunfig.all.toml test ./tests/smoke.db.test.ts ./tests/search.db.test.ts && bun --config=tests/bunfig.all.toml test ./tests/observability.db.test.ts && bun --config=tests/bunfig.all.toml test ./tests/observability-http.db.test.ts && bun --config=tests/bunfig.all.toml test ./tests/observability-shutdown.db.test.ts && bun --config=tests/bunfig.all.toml test ./tests/observability-built.db.test.ts",
		"test:http": "bun --config=tests/bunfig.all.toml test ./tests/http.http.test.ts",
		"prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.9",
		"@astrojs/mdx": "7.0.2",
		"@astrojs/node": "11.1.13",
		"@astrojs/react": "7.1.9",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@astrojs/vercel": "11.0.2",
		"@aws-sdk/client-s3": "3.1171.0",
		"@aws-sdk/s3-request-presigner": "3.1171.0",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
		"@opentelemetry/instrumentation": "^0.301.2",
		"@opentelemetry/instrumentation-pg": "^0.78.0",
		"@opentelemetry/resources": "^3.1.1",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@opentelemetry/sdk-trace-node": "^2.12.0",
		"@resvg/resvg-js": "2.6.2",
		"@tailwindcss/vite": "4.3.2",
		"astro": "7.4.12",
		"astro-expressive-code": "0.44.0",
		"astro-icon": "1.1.5",
		"astro-mermaid": "^2.1.0",
		"astro-robots-txt": "1.0.0",
		"astro-webmanifest": "1.0.0",
		"cssnano": "7.1.0",
		"emdash": "1.6.0",
		"hastscript": "9.0.1",
		"kysely": "0.29.9",
		"mdast-util-directive": "3.1.0",
		"mdast-util-to-markdown": "2.1.2",
		"mdast-util-to-string": "4.0.0",
		"mermaid": "^11.17.1",
		"pg": "8.23.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"reading-time": "1.5.0",
		"rehype-autolink-headings": "7.1.0",
		"rehype-external-links": "3.0.0",
		"rehype-unwrap-images": "1.0.0",
		"remark-directive": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-mdx": "3.1.1",
		"remark-parse": "11.0.0",
		"satori": "0.16.2",
		"sharp": "0.34.3",
		"unified": "11.0.5",
		"unist-util-visit": "5.0.0",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.9",
		"@biomejs/biome": "2.1.4",
		"@iconify-json/mdi": "1.2.3",
		"@tailwindcss/typography": "0.5.16",
		"@types/hast": "3.0.4",
		"@types/mdast": "4.0.4",
		"@types/pg": "^8.23.1",
		"autoprefixer": "10.4.21",
		"mdast-util-mdx-jsx": "3.2.0",
		"portless": "^0.15.6",
		"prettier": "3.6.2",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "0.6.14",
		"tailwindcss": "4.3.2",
		"typescript": "5.9.2"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild",
		"sharp"
	]
}
