# Only references live here; this file is safe for git. bin/k loads .env first, so the app
# secrets come from there, and the registry token comes from 1Password (names from .env).

SECRETS="$(kamal secrets fetch
  --adapter 1password
  --account $OP_ACCOUNT
  --from $OP_VAULT
  $OP_REGISTRY_ITEM)"

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract "$OP_REGISTRY_FIELD" $SECRETS)

PGPASSWORD=$PGPASSWORD
HYPERDX_API_KEY=$HYPERDX_API_KEY
